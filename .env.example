# Salin file ini menjadi .env, lalu isi dengan key RapidAPI-MU SENDIRI.
# Jangan pernah meng-commit file .env ke GitHub.
# Daftar dan subscribe (gratis) dulu di RapidAPI untuk API yang dipakai:
#  - TikTok: tiktok-scraper7
#  - INSTAGRAM: instagram-cheapest
RAPIDAPI_KEY=

# Opsional: ubah hanya kalau kamu pakai API RapidAPI lain yang setara.
TIKTOK_RAPIDAPI_HOST=tiktok-scraper7.p.rapidapi.com
TIKTOK_INFO_PATH=/user/info
TIKTOK_COMMENTS_PATH=/video/comments
INSTAGRAM_RAPIDAPI_HOST=instagram-cheapest.p.rapidapi.com
INSTAGRAM_USER_PATH=/api/v1/instagram/user
INSTAGRAM_COMMENTS_PATH=/api/v1/instagram/media_comments
